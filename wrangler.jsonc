{
  // Static site (next build -> out/) plus a tiny Worker for POST /api/enquiry. Deploy with: npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aspen-pharmaceuticals",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required by the Resend client.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the enquiry endpoint runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "ENQUIRY_TO": "aspeninfo03@gmail.com",
    "RESEND_FROM": "Aspen Website <enquiries@aspenpharmaceuticals.com>"
  }
  // Set the Resend key once with: npx wrangler secret put RESEND_API_KEY
}
