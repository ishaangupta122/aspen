{
  "name": "aspen-pharmaceuticals",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "mkdir -p out && wrangler dev --port 8787 --local --env-file .env.local",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "^0.446.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
